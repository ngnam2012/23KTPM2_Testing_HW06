  {
    "tc_id": "TC_FR04_SEC_09",
    "category": "Security (SEC-06 - SQL Injection in Name)",
    "description": "Ensure parameterized queries protect against SQL injection in name field",
    "method": "PUT",
    "endpoint": "/api/users/me",
    "headers": {
      "Content-Type": "application/json",
      "X-Student-Id": "25127001"
    },
    "body": {
      "name": "Admin' OR '1'='1'; --",
      "shipping_address": "123 Street",
      "phone": "0912345678"
    },
    "expected_status": 200
  },
  {
    "tc_id": "TC_FR04_SEC_10",
    "category": "Security (SEC-06 - SQL Injection in Phone)",
    "description": "Validate phone regex blocks SQL injection payloads in phone field",
    "method": "PUT",
    "endpoint": "/api/users/me",
    "headers": {
      "Content-Type": "application/json",
      "X-Student-Id": "25127001"
    },
    "body": {
      "name": "Nguyen Van A",
      "shipping_address": "123 Street",
      "phone": "0912345678' OR 1=1 --"
    },
    "expected_status": 400
  },
  {
    "tc_id": "TC_FR04_SEC_11",
    "category": "Security (SEC-06 - Stored XSS in Profile)",
    "description": "Verify stored XSS script tags are treated safely as plain text",
    "method": "PUT",
    "endpoint": "/api/users/me",
    "headers": {
      "Content-Type": "application/json",
      "X-Student-Id": "25127001"
    },
    "body": {
      "name": "<script>alert('XSS')</script>",
      "shipping_address": "<img src=x onerror=alert(1)>",
      "phone": "0912345678"
    },
    "expected_status": 200
  },
