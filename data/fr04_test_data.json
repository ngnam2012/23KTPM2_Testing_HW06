  {
    "tc_id": "TC_FR04_SEC_01",
    "category": "Security (SEC-06 - Privilege Escalation / Mass Assignment)",
    "description": "Attempt to elevate privileges to role='admin' via body payload",
    "method": "PUT",
    "endpoint": "/api/users/me",
    "headers": {
      "Content-Type": "application/json",
      "X-Student-Id": "25127001"
    },
    "body": {
      "name": "Attacker User",
      "shipping_address": "123 Hacker St",
      "phone": "0912345678",
      "role": "admin"
    },
    "expected_status": 200,
    "security_constraint": "Role must not be updated to admin in database"
  },
  {
    "tc_id": "TC_FR04_SEC_02",
    "category": "Security (SEC-06 - Boolean Admin Flag)",
    "description": "Attempt to inject isAdmin: true in body",
    "method": "PUT",
    "endpoint": "/api/users/me",
    "headers": {
      "Content-Type": "application/json",
      "X-Student-Id": "25127001"
    },
    "body": {
      "name": "Attacker User",
      "shipping_address": "123 Hacker St",
      "phone": "0912345678",
      "isAdmin": true
    },
    "expected_status": 200
  },
