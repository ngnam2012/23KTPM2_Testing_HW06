{
  "info": {
    "_postman_id": "fr15-admin-product-crud-25127001",
    "name": "FR-15: Admin Product CRUD Test Suite",
    "description": "Comprehensive Test Suite for FR-15 (POST, PUT, DELETE, GET /api/products) covering Broken Access Control (SEC-03), Domain Boundaries, Type Coercion, and CRUD Lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ensure mandatory Header X-Student-Id is attached to every request",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: pm.collectionVariables.get('studentId') || '25127001' });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "studentId", "value": "25127001", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "user_token", "value": "", "type": "string" },
    { "key": "created_product_id", "value": "6", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Setup & Auth",
      "item": [
        {
          "name": "0.1 Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eshop.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login Admin successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property('token');",
                  "    pm.collectionVariables.set('admin_token', data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "0.2 Login Regular User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@eshop.com\",\n  \"password\": \"Test1234!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login Regular User successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('user_token', data.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 1 - Broken Access Control (SEC-03 / BFLA)",
      "item": [
        {
          "name": "TC_FR15_BAC_01: Unauthenticated POST Product (Bug Hunter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthenticated Product\",\n  \"price\": 100000,\n  \"category_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_BAC_01: CRITICAL SEC-03 - Unauthenticated POST MUST return 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_BAC_04: Regular User POST Product (Bug Hunter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User Product Attempt\",\n  \"price\": 100000,\n  \"category_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_BAC_04: CRITICAL BFLA - Regular user MUST return 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_BAC_07: Admin POST Product (Valid Action)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tai nghe Sony WH-1000XM5\",\n  \"price\": 8490000,\n  \"description\": \"Chong on cao cap\",\n  \"imageUrl\": \"https://placehold.co/300\",\n  \"category_id\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_BAC_07: Admin creates product with 200/201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var res = pm.response.json();",
                  "    if (res.id) {",
                  "        pm.collectionVariables.set('created_product_id', String(res.id));",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_BAC_10: Forged Token on POST",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer fake.jwt.admin.token" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fake Token Product\",\n  \"price\": 100000,\n  \"category_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_BAC_10: Forged token rejected with 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 2 - Domain & Boundary Values",
      "item": [
        {
          "name": "TC_FR15_DOM_01: Zero Price Rejection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zero Price Product\",\n  \"price\": 0,\n  \"category_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_DOM_01: Price 0 rejected with 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_DOM_02: Negative Price Rejection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Negative Price Product\",\n  \"price\": -50000,\n  \"category_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_DOM_02: Negative price rejected with 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_DOM_06: Empty Name Rejection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"price\": 100000,\n  \"category_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_DOM_06: Empty name rejected with 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 3 - Type Coercion & Schema Validation",
      "item": [
        {
          "name": "TC_FR15_TYPE_01: Even ID Price Type Coercion Bug Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/2", "host": ["{{baseUrl}}"], "path": ["api", "products", "2"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_TYPE_01: Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC_FR15_TYPE_01: CRITICAL - Price MUST be number not string\", function () {",
                  "    var p = pm.response.json();",
                  "    pm.expect(p.price).to.be.a('number');",
                  "    pm.expect(typeof p.price).to.not.equal('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_SCHEMA_02: Odd ID Product Schema Validation",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_SCHEMA_02: Product 1 conforms to schema\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var p = pm.response.json();",
                  "    pm.expect(p.id).to.eql(1);",
                  "    pm.expect(p.price).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_SCHEMA_05: Non-existent Product 404 Status Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/999999", "host": ["{{baseUrl}}"], "path": ["api", "products", "999999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_SCHEMA_05: Non-existent product MUST return 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 4 - CRUD Lifecycle & Integrity",
      "item": [
        {
          "name": "TC_FR15_CRUD_01_PUT: Update Created Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tai nghe Sony WH-1000XM5 Updated\",\n  \"price\": 7990000,\n  \"description\": \"Gia giam soc\",\n  \"imageUrl\": \"https://placehold.co/300\",\n  \"category_id\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products/{{created_product_id}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{created_product_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_CRUD_01_PUT: Product updated with 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_CRUD_01_DEL: Delete Created Product",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/products/{{created_product_id}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{created_product_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_CRUD_01_DEL: Product deleted with 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR15_CRUD_05: SQLi in Search Query",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products?search=' OR '1'='1", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [{ "key": "search", "value": "' OR '1'='1" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR15_CRUD_05: CRITICAL SQLi - Server MUST NOT return HTML 500 error\", function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
