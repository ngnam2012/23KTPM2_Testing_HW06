{
  "info": {
    "_postman_id": "fr10-order-state-machine-25127001",
    "name": "FR-10: Order State Machine & Cancellation Test Suite",
    "description": "Comprehensive Test Suite for FR-10 (PUT /api/orders/:id/cancel & GET /api/orders/:id) covering State Transitions, BOLA/IDOR Security, Domain Boundaries, and Schema Validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Attach mandatory Header X-Student-Id to every request",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: pm.collectionVariables.get('studentId') || '25127001' });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "studentId", "value": "25127001", "type": "string" },
    { "key": "user_token_A", "value": "", "type": "string" },
    { "key": "user_token_B", "value": "", "type": "string" },
    { "key": "order_id_A", "value": "1", "type": "string" },
    { "key": "order_id_B", "value": "2", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Setup & Auth Seed",
      "item": [
        {
          "name": "0.1 Register User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User A\",\n  \"email\": \"usera_fr10@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/register", "host": ["{{baseUrl}}"], "path": ["api", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"User A registered or exists\", () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));"]
              }
            }
          ]
        },
        {
          "name": "0.2 Login User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usera_fr10@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login User A successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('user_token_A', data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "0.3 User A Checkout Order A1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_amount\": 150000,\n  \"shipping_address\": \"123 Nguyen Hue, Q1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User A created Order A1\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var res = pm.response.json();",
                  "    var orderId = res.orderId || res.id || res.order_id || (res.order && res.order.id);",
                  "    if (orderId) {",
                  "        pm.collectionVariables.set('order_id_A', String(orderId));",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "0.4 Register User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User B\",\n  \"email\": \"userb_fr10@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/register", "host": ["{{baseUrl}}"], "path": ["api", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"User B registered or exists\", () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));"]
              }
            }
          ]
        },
        {
          "name": "0.5 Login User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"userb_fr10@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/login", "host": ["{{baseUrl}}"], "path": ["api", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login User B successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('user_token_B', data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "0.6 User B Checkout Order B1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token_B}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_amount\": 300000,\n  \"shipping_address\": \"456 Le Loi, Q1\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User B created Order B1\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var res = pm.response.json();",
                  "    var orderId = res.orderId || res.id || res.order_id || (res.order && res.order.id);",
                  "    if (orderId) {",
                  "        pm.collectionVariables.set('order_id_B', String(orderId));",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 1 - State Machine Valid Transitions",
      "item": [
        {
          "name": "TC_FR10_STATE_01: Cancel Pending Order A1",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_A}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_A}}", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_STATE_01: Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC_FR10_STATE_01: Cancellation success message\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.message).to.eql(\"Order canceled successfully\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR10_STATE_02: Verify Order Status Changed to Canceled via GET",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_A}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_A}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_STATE_02: Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC_FR10_STATE_02: Order status is 'canceled' in DB\", function () {",
                  "    var order = pm.response.json();",
                  "    pm.expect(order.status).to.eql(\"canceled\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 2 - State Machine Invalid Transitions",
      "item": [
        {
          "name": "TC_FR10_INV_03: Double Cancellation on Already Canceled Order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_A}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_A}}", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_INV_03: Status code is 400 Bad Request on second cancel\", function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.eql(\"Cannot cancel this order.\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 3 - Security & BOLA/IDOR",
      "item": [
        {
          "name": "TC_FR10_SEC_01: BOLA on Cancel - User A attempts to cancel User B's Order",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_B}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_B}}", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_SEC_01: BOLA prevented on Cancel (404/403)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([404, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR10_SEC_02: BOLA on GET - User A views User B's Order (Bug Hunter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_B}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_B}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_SEC_02: CRITICAL BOLA - Unauthorized user MUST NOT view other's order (403/404)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR10_SEC_03: Missing Authorization Header",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_A}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_A}}", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_SEC_03: Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql(\"Unauthorized\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR10_SEC_05: Invalid JWT Token",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer fake.forged.jwt.token" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_A}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_A}}", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_SEC_05: Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().error).to.eql(\"Forbidden\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 4 - Domain, Boundary & Schema",
      "item": [
        {
          "name": "TC_FR10_DOM_05: Non-existent Order ID (999999)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/orders/999999/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "999999", "cancel"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR10_DOM_05: Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.json().error).to.eql(\"Order not found\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR10_SCHEMA_02: Order Details Schema Validation",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token_A}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/orders/{{order_id_A}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{order_id_A}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var schema = {",
                  "    \"type\": \"object\",",
                  "    \"required\": [\"id\", \"user_id\", \"total_amount\", \"shipping_address\", \"status\"],",
                  "    \"properties\": {",
                  "        \"id\": { \"type\": \"integer\" },",
                  "        \"user_id\": { \"type\": \"integer\" },",
                  "        \"total_amount\": { \"type\": \"number\" },",
                  "        \"shipping_address\": { \"type\": \"string\" },",
                  "        \"status\": { \"type\": \"string\" }",
                  "    }",
                  "};",
                  "pm.test(\"TC_FR10_SCHEMA_02: Conforms to Order JSON Schema\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(tv4.validate(pm.response.json(), schema)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
