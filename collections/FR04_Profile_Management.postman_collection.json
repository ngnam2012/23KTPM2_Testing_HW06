    {
      "name": "Group 2 - Security & Mass Assignment",
      "item": [
        {
          "name": "TC_FR04_SEC_01: Mass Assignment (role=admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Attacker User\",\n  \"shipping_address\": \"123 Hacker St\",\n  \"phone\": \"0912345678\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR04_SEC_01: Request handled\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR04_SEC_06: Missing Authorization Header",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Auth\",\n  \"shipping_address\": \"123 St\",\n  \"phone\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR04_SEC_06: Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().error).to.eql(\"Unauthorized\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR04_SEC_07: Invalid JWT Token",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer fake.invalid.jwt.token" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fake Token User\",\n  \"shipping_address\": \"123 St\",\n  \"phone\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR04_SEC_07: Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().error).to.eql(\"Forbidden\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR04_SEC_09: SQL Injection in Name",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin' OR '1'='1'; --\",\n  \"shipping_address\": \"123 Le Loi, Q1\",\n  \"phone\": \"0912345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR04_SEC_09: Safe handling (No 500 error)\", function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 3 - State & Data Integrity",
      "item": [
        {
          "name": "TC_FR04_STATE_01: Verify Full Profile Updates via GET",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR04_STATE_01: Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"TC_FR04_STATE_01: Profile fields contain values\", function () {",
                  "    var user = pm.response.json();",
                  "    pm.expect(user).to.have.property('id');",
                  "    pm.expect(user).to.have.property('email');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR04_STATE_05: Role Immutability Security Assertion",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR04_STATE_05: CRITICAL - Role MUST remain 'user'\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var user = pm.response.json();",
                  "    pm.expect(user.role).to.eql(\"user\");",
                  "    pm.expect(user.role).to.not.eql(\"admin\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Group 4 - Schema & Status Codes",
      "item": [
        {
          "name": "TC_FR04_SCHEMA_02: User Profile JSON Schema & No Password Exposure",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var schema = {",
                  "    \"type\": \"object\",",
                  "    \"required\": [\"id\", \"email\", \"name\", \"role\"],",
                  "    \"properties\": {",
                  "        \"id\": { \"type\": \"integer\" },",
                  "        \"email\": { \"type\": \"string\" },",
                  "        \"name\": { \"type\": \"string\" },",
                  "        \"role\": { \"type\": \"string\" }",
                  "    }",
                  "};",
                  "pm.test(\"TC_FR04_SCHEMA_02: Response conforms to User Schema\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(tv4.validate(pm.response.json(), schema)).to.be.true;",
                  "});",
                  "pm.test(\"TC_FR04_SCHEMA_02: SEC-07 Password field MUST NOT be exposed\", function () {",
                  "    var user = pm.response.json();",
                  "    pm.expect(user).to.not.have.property(\"password\");",
                  "    pm.expect(user).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
