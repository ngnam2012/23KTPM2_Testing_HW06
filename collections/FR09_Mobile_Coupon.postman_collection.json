    {
      "name": "Group 2 - Math & Calculation Edge Cases",
      "item": [
        {
          "name": "TC_FR09_MATH_01: Percent Formula Calculation (Bug Hunter)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAVE10\",\n  \"total_amount\": 500000,\n  \"user_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/apply-coupon", "host": ["{{baseUrl}}"], "path": ["api", "apply-coupon"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR09_MATH_01: CRITICAL MATH - 10% on 500k MUST yield discount_amount = +50,000\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.discount_amount).to.eql(50000);",
                  "    pm.expect(res.discount_amount).to.be.above(0);",
                  "    pm.expect(res.final_amount).to.eql(450000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC_FR09_MATH_07: Arithmetic Invariant Property (final + discount === total)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"BIGBUY\",\n  \"total_amount\": 750000,\n  \"user_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/apply-coupon", "host": ["{{baseUrl}}"], "path": ["api", "apply-coupon"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC_FR09_MATH_07: Arithmetic invariant holds (final + discount === total)\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.final_amount + res.discount_amount).to.eql(750000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
